{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 0.0.0.0",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/api-safety.test.mjs",
    "test:source-security": "node --experimental-strip-types --test tests/source-security.test.mjs",
    "test:python": "python-analysis/.venv/bin/python -m unittest discover -s python-analysis/tests -v",
    "test:mobile-api": "node --test mobile/scripts/api-request.test.mjs mobile/scripts/weight-records.test.mjs mobile/scripts/training-records.test.mjs mobile/scripts/food-records.test.mjs mobile/scripts/account.test.mjs",
    "test:mobile-types": "tsc --noEmit --project mobile/tsconfig.json",
    "test:db": "node --test tests/db-integration.test.mjs",
    "test:public": "node --test tests/public-api-smoke.test.mjs",
    "test:authenticated-live": "node tests/authenticated-live-e2e.mjs",
    "test:food-ai-account-live": "node tests/food-ai-account-live-e2e.mjs",
    "health:check": "node scripts/health-check.mjs",
    "test:all": "npm run test:unit && npm run test:source-security && npm run test:python && npm run test:mobile-api && npm run test:mobile-types && npm --prefix mobile run lint && npm run lint && npm run build && npm run test:db && npm run test:public",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.1",
    "@clerk/nextjs": "^7.7.1",
    "@clerk/shared": "^4.27.1",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "openai": "^7.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
