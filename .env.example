OPENAI_API_KEY=
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=1
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_MENU_MODEL=gpt-5.6-luna
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_CHAT_MAX_TOOL_CALLS=3
OPENAI_CHAT_MAX_OUTPUT_TOKENS=600
OPENAI_MENU_MAX_OUTPUT_TOKENS=1800
AI_CHAT_MAX_ANSWER_CHARACTERS=400

PYTHON_ANALYSIS_URL=http://127.0.0.1:8000
PYTHON_ANALYSIS_TIMEOUT_MS=120000
# TypeScript APIとPython分析APIの両方へ同じ十分に長いランダム値をsecret設定する。
PYTHON_INTERNAL_API_KEY=
PYTHON_OPENAI_TIMEOUT_SECONDS=50
PYTHON_OPENAI_MAX_RETRIES=1
OPENAI_BODY_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_BODY_ANALYSIS_MAX_OUTPUT_TOKENS=3000

AI_CHAT_DAILY_LIMIT=30
AI_MENU_DAILY_LIMIT=3
AI_REQUEST_COOLDOWN_SECONDS=5

DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
APP_ENV=development
ADMIN_CLERK_USER_IDS=

PREMIUM_MONTHLY_PRICE_YEN=1000
APPLE_COMMISSION_PERCENT=15
OPENAI_MODEL_PRICING_JSON={}
NEON_PLAN_NAME=Free
NEON_MONTHLY_COST_YEN=0
NEON_STORAGE_LIMIT_BYTES=0
OTHER_INFRA_MONTHLY_COST_YEN=0

# App Store課金検証。Sandbox確認中はsandbox、審査・本番配信時はproductionへ変更する。
APPLE_IAP_ENVIRONMENT=sandbox
APPLE_BUNDLE_ID=com.example.musclepas
APPLE_PREMIUM_PRODUCT_ID=com.example.musclepas.premium.monthly
# production時だけApp Store Connectの数値App IDを設定する。
APPLE_APP_ID=
# Apple PKIから取得したDER証明書をbase64化して、公開先ではsecretとして設定する。
APPLE_ROOT_CA_G2_BASE64=
APPLE_ROOT_CA_G3_BASE64=

# App Storeとサポートページへ表示する連絡先。
NEXT_PUBLIC_SUPPORT_EMAIL=
