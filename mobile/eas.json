{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ENABLE_API_BYPASS": "false",
        "EXPO_PUBLIC_SCREENSHOT_MODE": "false",
        "EXPO_PUBLIC_APPLE_PREMIUM_PRODUCT_ID": "com.kintorepas.premium.monthly"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6817630881"
      }
    }
  }
}
