{
  "expo": {
    "name": "筋トレPAS",
    "slug": "kintore-pas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kintore-pas-icon-v2.png",
    "scheme": "kintorepas",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "icon": "./assets/images/kintore-pas-icon-v2.png",
      "bundleIdentifier": "com.yoshida.kintorepas",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/kintore-pas-icon-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kintore-pas-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/kintore-pas-icon-v2.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "目標体型の参考画像を選ぶために写真へのアクセスを使用します。",
          "cameraPermission": "身体分析用の写真を撮影するためにカメラを使用します。",
          "microphonePermission": false
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
